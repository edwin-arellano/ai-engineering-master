# === LLM configuration ===
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4000

# === API keys ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === CAG defaults ===
DEFAULT_NUM_EXAMPLES=3
DEFAULT_PREPROCESSING=none
DEFAULT_OUTPUT_FORMAT=markdown

# === Runtime ===
ENVIRONMENT=development
LOG_LEVEL=INFO
