# === LiteLLM configuration ===
# Formato: "<provider>/<model>". LiteLLM resuelve el proveedor del prefijo.
PRIMARY_MODEL=anthropic/claude-haiku-4-5-20251001
FALLBACK_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_NUM_RETRIES=2
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4000

# === Reformulator: modelo barato para la fase de reformulación RAG (S09) ===
# Convierte la transcripción ruidosa en un brief tipado + search_text denso.
REFORMULATOR_PRIMARY_MODEL=openai/gpt-4o-mini
REFORMULATOR_FALLBACK_MODEL=anthropic/claude-haiku-4-5-20251001
REFORMULATOR_TEMPERATURE=0.0
REFORMULATOR_MAX_TOKENS=1200

# === Retrieval RAG end-to-end (S09) ===
# RAG_TOP_K alto a propósito: la estimación se genera en una sola pasada y se
# busca granularidad (antipatrón consciente; lo ideal es un top_k pequeño + etapas).
RAG_TOP_K=25
# Umbral de distancia coseno; depende mucho del corpus (apps con 0.4, otras con 0.85).
RAG_DISTANCE_THRESHOLD=0.6
# Presupuesto de tokens del context_block ensamblado en la fase de augmentation.
RAG_MAX_CONTEXT_TOKENS=16384
# Generación RAG-grounded: "razonamiento alto" aproximado con temperatura baja + más tokens.
RAG_GENERATION_TEMPERATURE=0.2
RAG_GENERATION_MAX_TOKENS=8000
RAG_ESTIMATION_PROMPT_VERSION=v1
REFORMULATION_PROMPT_VERSION=v1

# === Retrieval avanzado (S10): búsqueda híbrida + reranking ===
# Modo de búsqueda por defecto: vector (solo semántica) | hybrid (semántica+léxica+RRF).
RAG_SEARCH_MODE=vector
# Activa el reranking cross-encoder por defecto (recall-then-rerank).
RERANKING_ENABLED=false
# Cross-encoder multilingüe. Se descarga de HuggingFace la 1ª vez (cachea local) y
# se carga UNA vez al arranque: el healthcheck del contenedor debe tolerar ese retraso.
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# Recall amplio antes del reranking (top-N candidatos que lee el cross-encoder).
RETRIEVAL_CANDIDATE_POOL_SIZE=50
# Constante de suavizado de Reciprocal Rank Fusion (paper original: 60).
RRF_SMOOTHING_K=60

# === API keys (al menos UNA debe estar configurada) ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === Redis exact-match cache (S03) ===
# En docker-compose: redis://redis:6379/0
# En local sin docker: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400
CACHE_ENABLED=true

# === Sesión 04: embeddings y cache semántico ===
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMENSIONS=1536
# Tamaño de batch del pipeline de embeddings (S07).
EMBEDDING_BATCH_SIZE=100
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_NAME=estimator_semantic_cache

# === Sesión 04: guardrails ===
MODERATION_ENABLED=true
MIN_CONFIDENCE_PCT=30

# === Versionado de prompts (S04=v2; pre-S05=v3) ===
PROMPT_VERSION=v3

# === Pre-sesión 05: sesiones conversacionales ===
MAX_TURNS=6
SESSION_IDLE_TTL_SECONDS=86400
# 10 MB por adjunto.
ATTACHMENT_MAX_BYTES=10485760

# --- Sesión 05: tiers, compresión y Actor-Critic-Boss ---
DEFAULT_TIER=developer
COMPRESSION_POLICY=anchor_hybrid
COMPRESSION_TRIGGER_TURNS=6
COMPRESSION_KEEP_RECENT_TURNS=3
ACB_MAX_ITERATIONS=3
CRITIC_PROMPT_VERSION=v1
BOSS_PROMPT_VERSION=v1
SUMMARIZER_PROMPT_VERSION=v1

# --- Sesión 06: ingesta de datos ---
INGEST_SEED_DIR=data/seed
DATA_CATALOG_PATH=data/catalog/data_catalog.yaml
CATALOG_EVALUATOR_PROMPT_VERSION=v1

# --- Sesión 06: umbrales de viabilidad arquitectónica CAG ---
CAG_USABLE_CONTEXT_RATIO=0.7
CAG_LATENCY_SLA_SECONDS=4.0
CAG_COST_PER_TURN_BUDGET_USD=0.05

# --- Sesión 07: estrategias de chunking RAG ---
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=80
CHUNK_ORPHAN_MIN_TOKENS=20
SEMANTIC_BREAKPOINT_THRESHOLD=0.55
PROPOSITIONAL_PROMPT_VERSION=v1
CONTEXTUAL_RETRIEVAL_PROMPT_VERSION=v1

# === Persistencia pgvector (pre-S08) ===
# En local apunta a localhost:5433 (host remapeado para no chocar con el Postgres
# de Herd en 5432); docker-compose lo sobreescribe a host 'postgres':5432.
DATABASE_URL=postgresql+asyncpg://estimator:estimator@localhost:5433/estimator

# === RAG índice vectorial (S08) ===
# m y ef_construction se fijan al crear el índice (migración 0002). ef_search es en runtime.
HNSW_M=16
HNSW_EF_CONSTRUCTION=128
HNSW_EF_SEARCH=40

# === Streamlit / runtime ===
# URL del backend FastAPI desde el Streamlit. En local con backend dockerizado
# y Streamlit corriendo local: http://localhost:8000
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO
